# Postgres connection (Neon, Supabase, Railway or local)
DATABASE_URL=postgres://kickoff:kickoff@localhost:5432/kickoff

# Public URL of the app, used in share links and link previews
APP_URL=http://localhost:3000

# Protects /api/cron/tick. Your scheduler calls it every minute with
# the header "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=change-me

# Phone login and SMS. Leave empty in development: codes are printed to the
# server console and 000000 always works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Sign in with Apple: a Services ID from developer.apple.com (Identifiers > Services IDs),
# with APP_URL/api/auth/apple/callback as its return URL. While it's empty, the
# Apple button says it isn't set up yet and points people to phone sign-in.
APPLE_CLIENT_ID=

# City and ZIP search for Explore. Defaults to OpenStreetMap's public Nominatim
# (free, about one request a second). Point it at your own instance as traffic grows.
GEOCODER_URL=

# Where people write in. Shown on /support and /privacy, and in the App Store listing.
SUPPORT_EMAIL=support@pitchin.app

# --- iPhone app ---

# The app's bundle ID, the audience of its Sign in with Apple tokens.
APPLE_BUNDLE_IDS=app.pitchin.ios
# A Sign in with Apple key (Keys > + > Sign in with Apple), used to revoke Apple
# sign-in when someone deletes their account. Paste the .p8 with \n for newlines.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# App Review signs in with this number and code. No text is sent. Leave empty to turn it off.
AUTH_DEMO_PHONE=
AUTH_DEMO_CODE=

# Push notifications through Expo. App users get a push instead of a text.
PUSH_NOTIFICATIONS=true
# Only if "Enhanced push security" is on in the Expo project.
EXPO_ACCESS_TOKEN=

# Run the scheduler inside the web server every minute (Railway). Then no outside cron is needed.
TICK_IN_PROCESS=
