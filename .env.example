# Postgres connection (Neon, Supabase, Railway or local)
DATABASE_URL=postgres://kickoff:kickoff@localhost:5432/kickoff

# Public URL of the app, used in share links and link previews
APP_URL=http://localhost:3000

# Protects /api/cron/tick. Your scheduler calls it every minute with
# the header "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=change-me

# Phone login and SMS. Leave empty in development: codes are printed to the
# server console and 000000 always works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Sign in with Apple: a Services ID from developer.apple.com (Identifiers > Services IDs),
# with APP_URL/api/auth/apple/callback as its return URL. While it's empty, the
# Apple button says it isn't set up yet and points people to phone sign-in.
APPLE_CLIENT_ID=

# City and ZIP search for Explore. Defaults to OpenStreetMap's public Nominatim
# (free, about one request a second). Point it at your own instance as traffic grows.
GEOCODER_URL=
